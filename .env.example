# SFC customer WebService credentials (issued by your SFC account manager)
SFC_APP_KEY=
SFC_TOKEN=
SFC_USER_ID=

# Optional: default division / warehouse (try 1 first, then 17)
SFC_DIVISION_ID=1

# Optional: API hosts (defaults match official docs)
# SFC_HTTP_API_BASE=https://www.sfcservice.com/ishipsvc/http-api
# SFC_SOAP_WSDL=https://www.sfcservice.com/ishipsvc/web-service?wsdl
# SFC_TRACK_API=https://tracking.sfcservice.com/tracking/track-api/get-track
# SFC_LABEL_BASE=https://www.sfcservice.com/order/print/index/

# Optional: credentials file (default ~/.sfc/credentials.json)
# SFC_CREDENTIALS_FILE=

# Write safety: set to "false" to hide delete tool (create still available)
# SFC_ALLOW_DELETE=true
